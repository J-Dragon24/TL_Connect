                  "// Kiểm tra code trả về\r",
                  "if (res.code === 0) {\r",
                  "    // Lưu token vào environment\r",
                  "    let token = res.data.token;\r",
                  "    pm.environment.set(\"auth_token\", token);\r",
                  "    console.log(\"✅ Token saved successfully:\", token);\r",
